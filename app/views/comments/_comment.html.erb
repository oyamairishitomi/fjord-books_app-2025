<div>
  <p><%= comment.user.name.presence || comment.user.email %></p>
  <p><%= comment.body %></p>
  <p><%= l(comment.created_at, format: :long) %></p>
  <% if comment.user == current_user %>
    <%= button_to 'コメントを削除', polymorphic_path([commentable, comment]), method: :delete, data: { turbo_confirm: '本当に削除しますか？'} %>
  <% end %>
</div>
